{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.easytran.app/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api.easytran.app/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
