{
  "name": "wods",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "node --import tsx --test server/**/*.test.ts",
    "test:homepage-metrics": "node --import tsx --test scripts/homepage-metrics.test.ts",
    "test:architecture": "node --test scripts/schema-rpc-audit.test.mjs scripts/deploy-helpers.test.mjs",
    "db:check": "node scripts/apply-dashboard-readiness.mjs",
    "db:audit": "node scripts/audit-schema-rpcs.mjs",
    "db:apply": "node scripts/apply-dashboard-readiness.mjs --apply",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/kv": "^3.0.0",
    "bgutils-js": "^3.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^14.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "standardwebhooks": "^1.0.0",
    "three": "^0.186.1",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
